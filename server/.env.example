# Пример конфигурации backend модуля KDS Slicer Station.
# Скопируйте этот файл в server/.env и заполните реальными значениями.
# Файл server/.env в git не коммитится (см. .gitignore).

# --- Подключение к PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=arclient
DB_USER=postgres
DB_PASSWORD=your_password_here

# Часовой пояс ресторана. Задаётся ЯВНО, потому что часть колонок в схеме
# заказчика хранит время без пояса: при разных поясах у Node и PostgreSQL
# метрика «скорость готовки повара» уедет ровно на разницу (см. config/db.ts).
DB_TIMEZONE=Asia/Almaty

# Пределы, чтобы наши запросы не занимали соединения продакшн-сервера заказчика
DB_STATEMENT_TIMEOUT_MS=15000
DB_IDLE_TX_TIMEOUT_MS=30000

# --- Express сервер ---
# Frontend проксирует /api → localhost:3001 (см. vite.config.ts),
# поэтому менять порт не рекомендуется.
SERVER_PORT=3001

# Интерфейс прослушивания. По умолчанию 127.0.0.1 — наружу API отдаёт nginx
# с той же машины. Меняйте на 0.0.0.0 только если nginx на другом хосте,
# и тогда обязательно закройте 3001 на фаерволе.
SERVER_HOST=127.0.0.1

# Разрешённые origin'ы для CORS через запятую (dev-сервер Vite).
# В проде фронт раздаётся с того же хоста, и список можно оставить пустым.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
